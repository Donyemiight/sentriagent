# SentriAgent — Environment Configuration
# Copy this file to .env and fill in real values for local dev

NODE_ENV=production
PORT=8080

# MCP server transport (stdio for local CLI agents, http for remote)
MCP_STDIO=false

# Pricing (USDT per call)
PRICE_PER_CALL=0.01
PRICE_PER_BUNDLE=0.05

# OKX Agent Payments Protocol (APP) config
# This is the wallet that receives payments — MUST be set in production
PAYMENT_RECEIVER_ADDRESS=0xYourAgenticWalletAddressOnXLayer
PAYMENT_NETWORK=xlayer
PAYMENT_TOKEN=USDT

# Optional: External signal source API keys
# OKX onchainos-mcp
OKX_ONCHAINOS_API_KEY=

# GoPlus (free tier works without key, but rate-limited)
GOPLUS_API_KEY=

# De.Fi (free tier: 100 req/day)
DEFI_API_KEY=

# Cache TTL in seconds (default 60)
CACHE_TTL_SECONDS=60

# Rate limiting
RATE_LIMIT_PER_MINUTE=60